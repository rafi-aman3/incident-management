# Public — sent to the browser. Safe to commit values for non-prod environments.
NEXT_PUBLIC_SUPABASE_URL=https://uvziktjgrcosxirisiug.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role — used only by scripts/seed.ts to create auth users.
# Grab from Supabase Dashboard → Project Settings → API → service_role secret.
# NEVER prefix with NEXT_PUBLIC_ — this must stay server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI auth — used by `pnpm db:push` and `pnpm db:types` (loaded via
# scripts/with-env-file.mjs since the CLI doesn't read dotenv files natively).
# Personal access token: Dashboard → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
# Project DB password (set on project creation; resettable in Settings → Database).
SUPABASE_DB_PASSWORD=

# Argus AI assistant (Phase 9). Server-only — never prefix with NEXT_PUBLIC_.
# Get from https://aistudio.google.com → API Keys. Without this set, the
# Argus side panel falls back to "AI is offline" without 500ing.
GEMINI_API_KEY=

# Soft default for orgs.argus_daily_token_budget. Per-org override goes in DB.
# 10,000,000 tokens ≈ $25/day at Gemini 2.5 Flash output rates — sized for
# demo, not prod. Bumped from 5M (Anthropic-era) because Flash is ~5x cheaper.
ARGUS_DEFAULT_DAILY_TOKEN_BUDGET=10000000
